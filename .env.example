# ==============================================================================
# GEOSENTINEL CONFIGURATION ENVIRONMENT VARIABLES
# Copy this file to .env and adjust variables for your deployment environment.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL ACCESS KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=GeoSentinel
APP_PORT=8000
DEBUG=true

# Host & Network
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# AWS Integration (Public Open Data Registry works anonymously without keys)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS credentials are fully OPTIONAL: public datasets (Sentinel, MODIS, NOAA)
# are queried via anonymous S3 requests if keys are omitted.
AWS_ACCESS_KEY_ID=your_optional_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_optional_aws_secret_access_key
AWS_USE_ANONYMOUS=true

# S3 Earth Observation Open Data Buckets
SENTINEL2_S3_BUCKET=sentinel-s2-l2a
MODIS_S3_BUCKET=modis-pds
NOAA_HRRR_S3_BUCKET=noaa-hrrr-bdp-pds
LANDSAT_S3_BUCKET=landsat-pds

# Map & Cartography Settings
DEFAULT_AOI_NAME=Phoenix Metro, Arizona
DEFAULT_LATITUDE=33.4484
DEFAULT_LONGITUDE=-112.0740
DEFAULT_ZOOM=11
TILE_LAYER_STYLE=dark-tactical

# Telemetry & Ingestion
SIMULATED_INGESTION_RATE=2410
ORBITAL_PASS_INTERVAL_SECONDS=45
CACHE_TTL_SECONDS=300
